{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/walterlow/freecut-provider-releases/catalog-v1.schema.json",
  "title": "FreeCut provider catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "packages"],
  "properties": {
    "schema_version": { "const": 1 },
    "catalog_version": { "type": "string" },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind", "id", "name", "description", "version", "platform",
          "download_url", "archive_size", "sha256", "runtime_dependencies"
        ],
        "properties": {
          "kind": { "enum": ["runtime", "stt_provider"] },
          "id": { "type": "string", "pattern": "^[0-9A-Za-z._-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "platform": { "const": "windows-x86_64" },
          "engine": { "enum": ["whisper", "moss_transcribe_diarize"] },
          "backend": { "enum": ["auto", "cpu", "vulkan", "cuda"] },
          "download_url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "archive_size": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "runtime_dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "version"],
              "properties": {
                "id": { "type": "string", "pattern": "^[0-9A-Za-z._-]+$" },
                "version": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
